{
	"name": "nomercy-cast-receiver",
	"type": "module",
	"version": "1.0.0-alpha.0",
	"private": true,
	"packageManager": "yarn@4.13.0",
	"description": "NoMercy Cast Web Receiver — full Leanback web app served at cast.nomercy.tv for non-APK Cast targets",
	"scripts": {
		"dev": "vite --host --force",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "vue-tsc --noEmit",
		"lint": "eslint . --ext .ts,.vue --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "eslint --fix ./src --ext .ts,.vue --report-unused-disable-directives --max-warnings 0",
		"format": "prettier --write \"src/**/*.{ts,vue,css}\"",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@microsoft/signalr": "^10.0.0",
		"@nomercy-entertainment/nomercy-music-player": "0.2.15",
		"@nomercy-entertainment/nomercy-video-player": "^1.2.7",
		"@tanstack/vue-query": "^5.62.0",
		"hls.js": "^1.6.15",
		"vue": "^3.5.43",
		"vue-router": "^4.4.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "8.1.1",
		"@tailwindcss/vite": "^4.0.0",
		"@types/chromecast-caf-receiver": "^6.0.25",
		"@types/jsdom": "^30",
		"@types/node": "^25.0.3",
		"@vitejs/plugin-vue": "^6.0.3",
		"@vue/test-utils": "^2.5.1",
		"eslint": "^9.0.0",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-vuejs-accessibility": "^2.5.0",
		"jsdom": "^30.1.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.6.0",
		"vite": "^8.1.6",
		"vitest": "5.0.2",
		"vue-tsc": "^2.1.0"
	},
	"resolutions": {
		"brace-expansion@npm:^1.1.7": "^1.1.21",
		"brace-expansion@npm:^2.0.2": "^2.1.7",
		"brace-expansion@npm:^5.0.2": "^5.0.12",
		"brace-expansion@npm:^5.0.8": "^5.0.12",
		"immutable": ">=5.1.5",
		"ip-address": ">=10.5.1",
		"katex@npm:^0.16.0": "^0.18.2",
		"picomatch": ">=4.0.4",
		"postcss": ">=8.5.7",
		"rollup": ">=4.59.0",
		"tinypool@npm:2.1.0": "2.1.2",
		"yaml": ">=2.6.1"
	}
}
