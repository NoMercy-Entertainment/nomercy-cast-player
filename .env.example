# Copy to .env (git-ignored). Read by vite.config.ts for `yarn dev` only; `yarn build` ignores it.

# Your NoMercy media server. The dev server proxies /api, /videoHub and /musicHub to it.
# Unset: the dev server starts without the proxy and prints a warning.
CAST_DEV_SERVER_URL=https://your-server.example:7626

# Extra hostnames allowed to reach the dev server (comma separated), for example a dev tunnel.
# The host of CAST_DEV_SERVER_URL is always allowed.
CAST_DEV_ALLOWED_HOSTS=
